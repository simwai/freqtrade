{
  "name": "freqtrade-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite frontend --config frontend/vite.config.ts",
    "build": "vite build frontend --config frontend/vite.config.ts",
    "preview": "vite preview frontend --config frontend/vite.config.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "lint:fix": "biome check --write .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky",
    "openapi": "curl -s http://localhost:15001/openapi.json -o frontend/src/api/openapi.json"
  },
  "dependencies": {
    "@nuxt/ui": "^3.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "date-fns": "^4.1.0",
    "echarts": "^6.1.0",
    "pinia": "^3.0.1",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.13",
    "vue-echarts": "^8.3.0",
    "vue-router": "^4.5.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "biome": "^0.3.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.0.0"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "biome format --write",
      "biome check --write"
    ],
    "*.{py}": [
      "ruff format",
      "ruff check --fix"
    ]
  }
}
