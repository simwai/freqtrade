{
  "enabled": true,
  "debug": false,
  "placeholder_prefix": "__VG_",
  "session": {
    "ttl": "1h",
    "max_mappings": 100000
  },
  "patterns": {
    "keywords": [],
    "regex": [
      { "pattern": "sk-[A-Za-z0-9]{48}", "category": "OPENAI_KEY" },
      { "pattern": "(ghp|gho|ghu|ghs|ghr)_[A-Za-z0-9]+", "category": "GITHUB_TOKEN" },
      { "pattern": "AKIA[0-9A-Z]{16}", "category": "AWS_ACCESS_KEY" },
      { "pattern": "xox[baprs]-[A-Za-z0-9-]+", "category": "SLACK_TOKEN" },
      { "pattern": "eyJ[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+", "category": "JWT" },
      { "pattern": "gho_[A-Za-z0-9]{36}", "category": "GITHUB_OAUTH" },
      { "pattern": "ghu_[A-Za-z0-9]{36}", "category": "GITHUB_USER_TOKEN" },
      { "pattern": "ghs_[A-Za-z0-9]{36}", "category": "GITHUB_SERVER_TOKEN" },
      { "pattern": "ghr_[A-Za-z0-9]{36}", "category": "GITHUB_REFRESH_TOKEN" },
      { "pattern": "api_[A-Za-z0-9]{32}", "category": "GENERIC_API_KEY" },
      { "pattern": "secret_[A-Za-z0-9]{32}", "category": "GENERIC_SECRET" },
      { "pattern": "key_[A-Za-z0-9]{32}", "category": "GENERIC_KEY" },
      { "pattern": "token_[A-Za-z0-9]{32}", "category": "GENERIC_TOKEN" },
      { "pattern": "Bearer\\s+[A-Za-z0-9._-]+", "category": "BEARER_TOKEN" },
      { "pattern": "password\\s*[=:]\s*[^\\s]+", "category": "PASSWORD_ASSIGNMENT" },
      { "pattern": "secret\\s*[=:]\s*[^\\s]+", "category": "SECRET_ASSIGNMENT" },
      { "pattern": "api[_-]?key\\s*[=:]\s*[^\\s]+", "category": "API_KEY_ASSIGNMENT" },
      { "pattern": "private[_-]?key\\s*[=:]\s*[^\\s]+", "category": "PRIVATE_KEY_ASSIGNMENT" },
      { "pattern": "-----BEGIN [A-Z ]+PRIVATE KEY-----", "category": "PEM_PRIVATE_KEY" },
      { "pattern": "-----BEGIN RSA PRIVATE KEY-----", "category": "RSA_PRIVATE_KEY" },
      { "pattern": "-----BEGIN EC PRIVATE KEY-----", "category": "EC_PRIVATE_KEY" },
      { "pattern": "-----BEGIN OPENSSH PRIVATE KEY-----", "category": "OPENSSH_PRIVATE_KEY" },
      { "pattern": "ssh-rsa [A-Za-z0-9+/]+[=]{0,3}", "category": "SSH_PUBLIC_KEY" },
      { "pattern": "ssh-ed25519 [A-Za-z0-9+/]+[=]{0,3}", "category": "ED25519_PUBLIC_KEY" },
      { "pattern": "sk-[A-Za-z0-9]{20}T3BlbkFJ[A-Za-z0-9]{20}", "category": "OPENAI_PROJECT_KEY" },
      { "pattern": "sk-proj-[A-Za-z0-9]{48}", "category": "OPENAI_PROJECT_KEY_V2" },
      { "pattern": "sk-svcacct-[A-Za-z0-9]{48}", "category": "OPENAI_SERVICE_ACCOUNT" },
      { "pattern": "org_[A-Za-z0-9]{32}", "category": "ANTHROPIC_ORG_KEY" },
      { "pattern": "sk-ant-[A-Za-z0-9]{95}", "category": "ANTHROPIC_API_KEY" },
      { "pattern": "xai-[A-Za-z0-9]{32}", "category": "XAI_API_KEY" },
      { "pattern": "AIza[A-Za-z0-9_-]{35}", "category": "GOOGLE_API_KEY" },
      { "pattern": "ya29\\.[A-Za-z0-9_-]+", "category": "GOOGLE_OAUTH_TOKEN" },
      { "pattern": "r_[A-Za-z0-9]{32}", "category": "REPLIT_API_KEY" },
      { "pattern": "replit_[A-Za-z0-9]{32}", "category": "REPLIT_TOKEN" },
      { "pattern": "hf_[A-Za-z0-9]{37}", "category": "HUGGINGFACE_TOKEN" },
      { "pattern": "hvs\\.[A-Za-z0-9]+", "category": "VAULT_TOKEN" },
      { "pattern": "vault\\.token\\s*[=:]\s*[^\\s]+", "category": "VAULT_TOKEN_ASSIGNMENT" },
      { "pattern": "AWS[_-]?ACCESS[_-]?KEY[_-]?ID\\s*[=:]\s*[A-Z0-9]{20}", "category": "AWS_ACCESS_KEY_ID" },
      { "pattern": "AWS[_-]?SECRET[_-]?ACCESS[_-]?KEY\\s*[=:]\s*[A-Za-z0-9/+=]{40}", "category": "AWS_SECRET_ACCESS_KEY" },
      { "pattern": "aws_session_token\\s*[=:]\s*[A-Za-z0-9/+=]+", "category": "AWS_SESSION_TOKEN" },
      { "pattern": "AZURE[_-]?CLIENT[_-]?ID\\s*[=:]\s*[a-f0-9-]{36}", "category": "AZURE_CLIENT_ID" },
      { "pattern": "AZURE[_-]?CLIENT[_-]?SECRET\\s*[=:]\s*[^\\s]+", "category": "AZURE_CLIENT_SECRET" },
      { "pattern": "AZURE[_-]?TENANT[_-]?ID\\s*[=:]\s*[a-f0-9-]{36}", "category": "AZURE_TENANT_ID" },
      { "pattern": "DATABASE[_-]?URL\\s*[=:]\s*[^\\s]+", "category": "DATABASE_URL" },
      { "pattern": "MONGODB[_-]?URI\\s*[=:]\s*[^\\s]+", "category": "MONGODB_URI" },
      { "pattern": "REDIS[_-]?URL\\s*[=:]\s*[^\\s]+", "category": "REDIS_URL" },
      { "pattern": "POSTGRES[_-]?URL\\s*[=:]\s*[^\\s]+", "category": "POSTGRES_URL" },
      { "pattern": "MYSQL[_-]?URL\\s*[=:]\s*[^\\s]+", "category": "MYSQL_URL" },
      { "pattern": "MSSQL[_-]?URL\\s*[=:]\s*[^\\s]+", "category": "MSSQL_URL" },
      { "pattern": "SNOWFLAKE[_-]?ACCOUNT\\s*[=:]\s*[^\\s]+", "category": "SNOWFLAKE_ACCOUNT" },
      { "pattern": "SNOWFLAKE[_-]?USER\\s*[=:]\s*[^\\s]+", "category": "SNOWFLAKE_USER" },
      { "pattern": "SNOWFLAKE[_-]?PASSWORD\\s*[=:]\s*[^\\s]+", "category": "SNOWFLAKE_PASSWORD" },
      { "pattern": "STRIPE[_-]?SECRET[_-]?KEY\\s*[=:]\s*sk_live_[A-Za-z0-9]{24}", "category": "STRIPE_SECRET_KEY" },
      { "pattern": "STRIPE[_-]?PUBLISHABLE[_-]?KEY\\s*[=:]\s*pk_live_[A-Za-z0-9]{24}", "category": "STRIPE_PUBLISHABLE_KEY" },
      { "pattern": "STRIPE[_-]?WEBHOOK[_-]?SECRET\\s*[=:]\s*whsec_[A-Za-z0-9]{32}", "category": "STRIPE_WEBHOOK_SECRET" },
      { "pattern": "TWILIO[_-]?ACCOUNT[_-]?SID\\s*[=:]\s*AC[a-f0-9]{32}", "category": "TWILIO_ACCOUNT_SID" },
      { "pattern": "TWILIO[_-]?AUTH[_-]?TOKEN\\s*[=:]\s*[A-Za-z0-9]{32}", "category": "TWILIO_AUTH_TOKEN" },
      { "pattern": "SENDGRID[_-]?API[_-]?KEY\\s*[=:]\s*SG\\.[A-Za-z0-9._-]+", "category": "SENDGRID_API_KEY" },
      { "pattern": "MAILGUN[_-]?API[_-]?KEY\\s*[=:]\s*[A-Za-z0-9._-]+", "category": "MAILGUN_API_KEY" },
      { "pattern": "POSTMARK[_-]?SERVER[_-]?TOKEN\\s*[=:]\s*[A-Za-z0-9]{32}", "category": "POSTMARK_TOKEN" },
      { "pattern": "DISCORD[_-]?BOT[_-]?TOKEN\\s*[=:]\s*[A-Za-z0-9._-]{59,}", "category": "DISCORD_BOT_TOKEN" },
      { "pattern": "DISCORD[_-]?WEBHOOK[_-]?URL\\s*[=:]\s*https://discord(app)?.com/api/webhooks/[0-9]+/[A-Za-z0-9_-]+", "category": "DISCORD_WEBHOOK" },
      { "pattern": "SLACK[_-]?BOT[_-]?TOKEN\\s*[=:]\s*xoxb-[A-Za-z0-9-]+", "category": "SLACK_BOT_TOKEN" },
      { "pattern": "SLACK[_-]?USER[_-]?TOKEN\\s*[=:]\s*xoxp-[A-Za-z0-9-]+", "category": "SLACK_USER_TOKEN" },
      { "pattern": "SLACK[_-]?SIGNING[_-]?SECRET\\s*[=:]\s*[A-Za-z0-9]{32}", "category": "SLACK_SIGNING_SECRET" },
      { "pattern": "HEROKU[_-]?API[_-]?KEY\\s*[=:]\s*[a-f0-9-]{36}", "category": "HEROKU_API_KEY" },
      { "pattern": "NETLIFY[_-]?AUTH[_-]?TOKEN\\s*[=:]\s*[A-Za-z0-9._-]+", "category": "NETLIFY_AUTH_TOKEN" },
      { "pattern": "VERCEL[_-]?TOKEN\\s*[=:]\s*[A-Za-z0-9._-]+", "category": "VERCEL_TOKEN" },
      { "pattern": "CF[_-]?API[_-]?TOKEN\\s*[=:]\s*[A-Za-z0-9._-]+", "category": "CLOUDFLARE_API_TOKEN" },
      { "pattern": "CLOUDFLARE[_-]?API[_-]?KEY\\s*[=:]\s*[A-Za-z0-9]{37}", "category": "CLOUDFLARE_API_KEY" },
      { "pattern": "CLOUDFLARE[_-]?EMAIL\\s*[=:]\s*[^\\s]+@[^\\s]+", "category": "CLOUDFLARE_EMAIL" },
      { "pattern": "DIGITALOCEAN[_-]?TOKEN\\s*[=:]\s*[A-Za-z0-9]{64}", "category": "DIGITALOCEAN_TOKEN" },
      { "pattern": "LINODE[_-]?TOKEN\\s*[=:]\s*[A-Za-z0-9]{64}", "category": "LINODE_TOKEN" },
      { "pattern": "VULTR[_-]?API[_-]?KEY\\s*[=:]\s*[A-Za-z0-9]{64}", "category": "VULTR_API_KEY" },
      { "pattern": "JWT[_-]?SECRET\\s*[=:]\s*[A-Za-z0-9+/=]{32,}", "category": "JWT_SECRET" },
      { "pattern": "JWT[_-]?SIGNING[_-]?KEY\\s*[=:]\s*[A-Za-z0-9+/=]{32,}", "category": "JWT_SIGNING_KEY" },
      { "pattern": "SESSION[_-]?SECRET\\s*[=:]\s*[A-Za-z0-9+/=]{32,}", "category": "SESSION_SECRET" },
      { "pattern": "COOKIE[_-]?SECRET\\s*[=:]\s*[A-Za-z0-9+/=]{32,}", "category": "COOKIE_SECRET" },
      { "pattern": "CSRF[_-]?SECRET\\s*[=:]\s*[A-Za-z0-9+/=]{32,}", "category": "CSRF_SECRET" },
      { "pattern": "ENCRYPTION[_-]?KEY\\s*[=:]\s*[A-Za-z0-9+/=]{32,}", "category": "ENCRYPTION_KEY" },
      { "pattern": "SECRET[_-]?KEY\\s*[=:]\s*[A-Za-z0-9+/=]{32,}", "category": "SECRET_KEY" }
    ],
    "builtin": ["email", "uuid", "ipv4", "mac", "ipv6", "credit_card", "ssn", "iban", "phone_e164"],
    "exclude": ["example.com", "localhost", "127.0.0.1", "0.0.0.0", "test.com", "example.org", "example.net", "fake.com", "dummy.com", "localhost.localdomain", "test.local"]
  },
  "file_filters": {
    "include": ["**/*"],
    "exclude": ["**/node_modules/**", "**/.git/**", "**/dist/**", "**/build/**", "**/*.min.js", "**/*.map", "**/coverage/**", "**/.next/**", "**/.nuxt/**", "**/.svelte-kit/**", "**/*.lock", "**/*.log", "**/*.tmp", "**/*.bak"]
  },
  "output": {
    "format": "placeholder",
    "show_categories": true,
    "preserve_length": false
  }
}
